{
  "name": "@ai4paper/apaper-plugin",
  "version": "0.2.3",
  "description": "Academic writing skills and MCP configuration for Claude Code, Codex, and OpenCode.",
  "type": "module",
  "bin": {
    "apaper-install": "scripts/install.mjs"
  },
  "files": [
    "install.sh",
    "scripts",
    "mcp",
    "skills",
    "README.md",
    "LICENSE"

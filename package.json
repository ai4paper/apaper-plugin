{
  "name": "@ai4paper/apaper-plugin",
  "version": "0.2.3",
  "description": "Academic paper authoring plugin for DeepSeek Harness.",
  "type": "module",
  "exports": {
    "./dsh": {
      "types": "./dsh/index.d.ts",
      "import": "./dsh/index.js"
    }
  },
  "files": [
    "dsh",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai4paper/apaper-plugin.git"
  },
  "homepage": "https://github.com/ai4paper/apaper-plugin#readme",
  "bugs": "https://github.com/ai4paper/apaper-plugin/issues",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "academic-writing"
  ],
  "author": "ai4paper",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2"
  }
}
